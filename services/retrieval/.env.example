# Copie para .env para rodar o serviço fora do Docker.
# A senha do banco é a RETRIEVAL_DB_PASSWORD do .env da raiz do repositório.
PORT=8000
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=post_sale
DATABASE_USER=retrieval_service
DATABASE_PASSWORD=
RETRIEVAL_API_KEY=
EMBEDDINGS_PROVIDER=ollama
EMBEDDINGS_MODEL=bge-m3
OLLAMA_BASE_URL=http://localhost:11434
AWS_REGION=us-east-1
LOG_LEVEL=INFO
