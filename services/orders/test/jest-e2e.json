{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "setupFiles": ["<rootDir>/setup-env.ts"],
  "setupFilesAfterEnv": ["<rootDir>/setup-contract.ts"],
  "maxWorkers": 1,
  "testTimeout": 15000
}
