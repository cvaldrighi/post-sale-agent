# Copie para .env para rodar a api fora do Docker (npm run start:dev).
# A senha do banco é a APP_DB_PASSWORD do .env da raiz do repositório.
PORT=3000
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=post_sale
DATABASE_USER=app_service
DATABASE_PASSWORD=
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=3600
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
LLM_TIMEOUT_MS=60000
LLM_MAX_TOKENS=1024
LLM_HISTORY_LIMIT=20
OLLAMA_BASE_URL=http://localhost:11434
AWS_REGION=us-east-1
LOG_LEVEL=info
