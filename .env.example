# Modelo do .env. Não coloque valores reais aqui: este arquivo vai para o repositório.
# Copie para .env e preencha as senhas (só valem para o seu Postgres local).

# --- Postgres (superusuário, usado só para criar schemas e usuários) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=post_sale

# --- Um usuário por serviço, cada um dono apenas do seu schema ---
APP_DB_PASSWORD=
RETRIEVAL_DB_PASSWORD=
ORDERS_DB_PASSWORD=

# --- Chave que a api usa para chamar o serviço orders (mínimo de 16 caracteres) ---
ORDERS_API_KEY=

# --- Segredo que assina os tokens dos clientes na api (mínimo de 32 caracteres) ---
JWT_SECRET=

# --- Provedor de LLM da api: ollama (padrão) ou bedrock ---
# LLM_PROVIDER=bedrock
# LLM_MODEL=us.anthropic.claude-haiku-5-5
