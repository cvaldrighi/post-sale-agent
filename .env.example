# Copie para .env e ajuste. O .env nunca vai para o repositório.

# --- Postgres (superusuário, usado só para criar schemas e usuários) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=post_sale

# --- Um usuário por serviço, cada um dono apenas do seu schema ---
APP_DB_PASSWORD=app_dev_password
RETRIEVAL_DB_PASSWORD=retrieval_dev_password
ORDERS_DB_PASSWORD=orders_dev_password
