{
  "openapi": "3.1.0",
  "info": {
    "title": "post-sale-agent retrieval",
    "description": "Busca semântica nas políticas da loja (RAG). Consumido pela api do agente.",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "operations"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/documents": {
      "post": {
        "tags": [
          "documents"
        ],
        "summary": "Ingere ou atualiza um documento de política",
        "operationId": "ingest_documents_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DocumentIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentOut"
                }
              }
            }
          },
          "200": {
            "description": "Documento já existia",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentOut"
                }
              }
            }
          },
          "400": {
            "description": "validation_error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "embeddings_unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/search": {
      "post": {
        "tags": [
          "search"
        ],
        "summary": "Busca os trechos das políticas mais relevantes para uma pergunta",
        "operationId": "search_search_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchOut"
                }
              }
            }
          },
          "400": {
            "description": "validation_error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "embeddings_unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "DocumentIn": {
        "properties": {
          "source": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,100}$",
            "title": "Source",
            "description": "Identificador estável do documento, ex.: trocas-e-devolucoes",
            "examples": [
              "trocas-e-devolucoes"
            ]
          },
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Title",
            "examples": [
              "Política de Trocas e Devoluções"
            ]
          },
          "content": {
            "type": "string",
            "maxLength": 100000,
            "minLength": 1,
            "title": "Content",
            "description": "Conteúdo em Markdown"
          }
        },
        "type": "object",
        "required": [
          "source",
          "title",
          "content"
        ],
        "title": "DocumentIn"
      },
      "DocumentOut": {
        "properties": {
          "source": {
            "type": "string",
            "title": "Source"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "chunkCount": {
            "type": "integer",
            "title": "Chunkcount"
          },
          "changed": {
            "type": "boolean",
            "title": "Changed",
            "description": "false quando o documento já estava igual e nada foi refeito"
          }
        },
        "type": "object",
        "required": [
          "source",
          "title",
          "chunkCount",
          "changed"
        ],
        "title": "DocumentOut"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "examples": [
              "ok"
            ]
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "Health"
      },
      "Problem": {
        "properties": {
          "type": {
            "type": "string",
            "title": "Type"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "status": {
            "type": "integer",
            "title": "Status"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "code": {
            "type": "string",
            "enum": [
              "unauthorized",
              "validation_error",
              "service_unavailable",
              "embeddings_unavailable",
              "not_found",
              "internal_error"
            ],
            "title": "Code"
          }
        },
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "title": "Problem",
        "description": "Corpo de erro (também documentado no contrato OpenAPI)."
      },
      "SearchIn": {
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Query",
            "examples": [
              "posso cancelar um pedido atrasado?"
            ]
          },
          "topK": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Topk",
            "default": 5
          }
        },
        "type": "object",
        "required": [
          "query"
        ],
        "title": "SearchIn"
      },
      "SearchOut": {
        "properties": {
          "results": {
            "items": {
              "$ref": "#/components/schemas/SearchResult"
            },
            "type": "array",
            "title": "Results"
          }
        },
        "type": "object",
        "required": [
          "results"
        ],
        "title": "SearchOut"
      },
      "SearchResult": {
        "properties": {
          "chunkId": {
            "type": "integer",
            "title": "Chunkid"
          },
          "source": {
            "type": "string",
            "title": "Source"
          },
          "documentTitle": {
            "type": "string",
            "title": "Documenttitle"
          },
          "section": {
            "type": "string",
            "title": "Section",
            "description": "Caminho da seção, ex.: Política de Trocas > Prazo para troca"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "score": {
            "type": "number",
            "title": "Score",
            "description": "Relevância (RRF): maior é melhor"
          }
        },
        "type": "object",
        "required": [
          "chunkId",
          "source",
          "documentTitle",
          "section",
          "text",
          "score"
        ],
        "title": "SearchResult"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "APIKeyHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key"
      }
    }
  }
}
